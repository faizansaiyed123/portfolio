# Required for free Gemini AI responses
GEMINI_API_KEY=

# Optional Gemini model; the default has a free API tier.
GEMINI_MODEL=gemini-flash-latest

# Optional but recommended for production GitHub API capacity.
# Public repositories work without this token.
GITHUB_TOKEN=

# Portfolio identity / live source discovery
GITHUB_OWNER=faizansaiyed123
PORTFOLIO_REPO=faizansaiyed123/portfolio

# Required in production for durable caching + distributed rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Browser origins allowed to call the API.
CORS_ORIGINS=https://faizansaiyed123.github.io,http://localhost:8080,http://127.0.0.1:8080
